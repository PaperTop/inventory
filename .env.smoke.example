# Optional local integration tests only. Copy to .env.smoke.local.
# NEVER add this file's credentials to hosting settings or use real-user accounts.
# Supabase URL/public key are loaded separately from .env.local.
# Disposable confirmed account for npm run test:supabase and npm run test:photos.
SMOKE_EMAIL=
SMOKE_PASSWORD=
# Second disposable confirmed account for photo ownership/isolation checks.
SMOKE_OTHER_EMAIL=
SMOKE_OTHER_PASSWORD=
