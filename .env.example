# Required. Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Default is search with demo intent expansion; no model calls.
AI_PROVIDER=search
# Open-source inference via Ollama or a self-hosted compatible endpoint.
# Set AI_PROVIDER=openai-compatible to enable.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=
# Native Gemini tool calling: set AI_PROVIDER=google, AI_MODEL to an available
# Gemini model, and AI_API_KEY to your Google AI Studio key. AI_BASE_URL is ignored.
# Optional server-only Claude adapter; set AI_PROVIDER=claude to enable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only for the explicit integration smoke command; use a disposable confirmed user.
SMOKE_EMAIL=
SMOKE_PASSWORD=
# Second disposable account, used only by npm run test:photos for isolation.
SMOKE_OTHER_EMAIL=
SMOKE_OTHER_PASSWORD=
