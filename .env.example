# App configuration only. Copy to .env.local; never overwrite existing credentials.
# Set these same five variables in hosting settings for a Claude deployment.
# Supabase Dashboard → Project Settings → API. Use the public key, not service-role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Claude is enabled once you supply ANTHROPIC_API_KEY below.
# Set AI_PROVIDER=search for deterministic search without model calls.
AI_PROVIDER=claude
# Server-only Claude settings. Never use a NEXT_PUBLIC_ prefix for the key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional inference alternatives are documented in README.md.
# Disposable integration-test credentials belong in .env.smoke.local, not hosting.
