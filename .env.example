# Required. Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Claude is enabled once you supply ANTHROPIC_API_KEY below.
# Set AI_PROVIDER=search for deterministic search without model calls.
AI_PROVIDER=claude
# Open-source inference via Ollama or a self-hosted compatible endpoint.
# Set AI_PROVIDER=openai-compatible to enable.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=
# Server-only Claude settings. Never use a NEXT_PUBLIC_ prefix for the key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Only for the explicit integration smoke command; use a disposable confirmed user.
SMOKE_EMAIL=
SMOKE_PASSWORD=
# Second disposable account, used only by npm run test:photos for isolation.
SMOKE_OTHER_EMAIL=
SMOKE_OTHER_PASSWORD=
