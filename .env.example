# Required. Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Default is lexical search without a model; the UI labels it honestly.
AI_PROVIDER=search
# Open-source inference via Ollama or a self-hosted compatible endpoint.
# Set AI_PROVIDER=openai-compatible to enable.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3:8b
AI_API_KEY=
# Optional server-only Claude adapter; set AI_PROVIDER=claude to enable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only for the explicit integration smoke command; use a disposable confirmed user.
SMOKE_EMAIL=
SMOKE_PASSWORD=
